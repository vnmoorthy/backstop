# Backstop — sponsor credentials.
# Copy to `.env` (gitignored) and fill what you have. Each key present flips that
# sponsor's dashboard badge from `sim` to `real`. PAVO is always real (vendored
# weights). Missing keys fall back to a deterministic local sim — the demo runs
# either way and the badge never lies.

# Moss — real-time semantic retrieval
MOSS_API_KEY=
MOSS_BASE_URL=https://api.usemoss.dev

# LiveKit — real-time voice transport (needs URL + key + secret)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# TrueFoundry — AI gateway (routing, PHI redaction, audit, cost ledger)
TRUEFOUNDRY_API_KEY=
TRUEFOUNDRY_BASE_URL=https://api.truefoundry.com

# Unsiloed — EOB / CMS-1500 parsing
UNSILOED_API_KEY=
UNSILOED_BASE_URL=https://api.unsiloed.ai

# MiniMax — mid-tier reasoning + multilingual
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Qwen (DashScope) — brand-voice TTS
QWEN_API_KEY=
QWEN_VOICE_ID=appeals_coordinator

# AWS — elastic burst compute
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
